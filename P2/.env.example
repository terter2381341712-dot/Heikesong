# 实际启动不会自动加载本文件；复制并填写后由 shell / 进程管理器注入环境变量。
RESOURCE_BASE_URL=http://127.0.0.1:8001
TASK_BIND_HOST=0.0.0.0
TASK_PORT=8002
TASK_DATA_DIR=/absolute/path/to/p2-data
DEMO_TOKEN=replace-with-team-demo-token
TASK_TOKEN=replace-with-distinct-server-task-token
# 模拟 P1 只在测试时显式启用，生产 P2 不读取此开关、不内置模拟回退。
# P2_ENABLE_MOCK_P1=1
# MOCK_P1_PORT=18001
